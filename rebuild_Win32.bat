@echo off
setlocal EnableExtensions
rem Compatibility filename: this builds Windows x64 only.
pushd "%~dp0"
set "BUILD_CONFIG=Release"
set "BUILD_PRESET=windows-release"
set "PACKAGE_BUILD=1"
set "CLEAN_BUILD=--clean-first"
:args
if "%~1"=="" goto build
if /i "%~1"=="--debug" (
    set "BUILD_CONFIG=Debug"
    set "BUILD_PRESET=windows-debug"
) else if /i "%~1"=="--no-package" (
    set "PACKAGE_BUILD=0"
) else if /i "%~1"=="--incremental" (
    set "CLEAN_BUILD="
) else (
    echo Usage: rebuild_Win32.bat [--debug] [--no-package] [--incremental]
    popd
    exit /b 2
)
shift
goto args
:build
rem Copy YAML unchanged and regenerate IDs before compiling the game.
if not exist "Tools\AuroraMX\node_modules\.bin\esbuild.cmd" (
    call npm ci --prefix "Tools\AuroraMX" --no-audit --no-fund
    if errorlevel 1 goto failed
)
call npm run build:cli --prefix "Tools\AuroraMX"
if errorlevel 1 goto failed
cmake -E rm -rf "build/windows-x64/auroramx/bin"
if errorlevel 1 goto failed
node "Tools\AuroraMX\build\cli.cjs" batch "Data\Sprites\Sprites.sprcmd" --output "build/windows-x64/auroramx"
if errorlevel 1 goto failed
python "tools\sprite_resources.py" --source "Data/Sprites" --exports "build/windows-x64/auroramx/bin" --seed "Build/bin" --output "build/windows-x64/assets" --headers "Src/Autogenerated"
if errorlevel 1 goto failed
cmake --preset windows-x64 -DCASTLE_ASSET_DIR="%CD:\=/%/build/windows-x64/assets"
if errorlevel 1 goto failed
cmake --build --preset %BUILD_PRESET% %CLEAN_BUILD%
if errorlevel 1 goto failed
ctest --preset %BUILD_PRESET%
if errorlevel 1 goto failed
if "%PACKAGE_BUILD%"=="0" goto done
cpack --config "build/windows-x64/CPackConfig.cmake" -C %BUILD_CONFIG% -B "build/packages"
if errorlevel 1 goto failed
:done
echo Ready: build\windows-x64\bin\%BUILD_CONFIG%\FortressDefender.exe
popd
exit /b 0
:failed
popd
exit /b 1
