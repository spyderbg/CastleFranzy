#!/bin/bash

# This is a wrapper around texturetool to fake PVRTexTool.exe on Windoze. This
# way, the PVR converter is simpler.

# convert command line to something understood by texturetool
args=()
while (( $# > 0 )) ; do
    arg=( "$1" )
    case "$arg" in
	-i* )
	    arg=$(echo "$arg" | sed -e 's/^-i//')
	    ;;

	-f* )
	    fmt=$(echo "$arg" | sed -e 's/^-f//')
	    case "$fmt" in
		OGLPVRTC2 )
		    arg=( "-ePVRTC" "--bits-per-pixel-2" )
		    ;;
		OGLPVRTC4 )
		    arg=( "-ePVRTC" "--bits-per-pixel-4" )
		    ;;
		* )
		    # set encoder and let texture report the error
		    arg="-e$fmt"
		    ;;
	    esac
	    ;;

	-p )
	    arg="-fPVR"
	    ;;

	-x* )
	    arg=""
	    ;;

	-y* )
	    arg=""
	    ;;

	-nt )
	    arg=""
	    ;;
    esac 
    shift
    tmp_args="${arg[@]}"
    if [ "z$tmp_args" != "z" ] ; then
	args=( "${args[@]}" "${arg[@]}" )
    fi
done

# later on, me might want to do careful search/selection of available
# texturetool
texturetool=/Developer/Platforms/iPhoneOS.platform/Developer/usr/bin/texturetool

[ "$PVRTEXTOOL_VERBOSE" ] && echo "$texturetool ${args[@]}" > /dev/stderr
exec $texturetool "${args[@]}"
