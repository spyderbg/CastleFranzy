			/>
			<Tool
				Name="VCWebDeploymentTool"
			/>
			<Tool
				Name="VCPostBuildEventTool"
				Description="Copy plug-ins over"
				CommandLine="copy /Y &quot;$(OutDir)\ColladaMax.dle&quot; &quot;%MAX_PATH9%\plugins\ColladaMax.dle&quot;&#x0D;&#x0A;copy /Y ..\External\DirectX\Bin\D3DX9_37.dll &quot;%MAX_PATH9%\D3DX9_37.dll&quot;&#x0D;&#x0A;md &quot;..\bin\$(ConfigurationName)&quot; 2&gt; nul&#x0D;&#x0A;copy /Y &quot;$(OutDir)\ColladaMax.dle&quot; &quot;..\bin\$(ConfigurationName)&quot;&#x0D;&#x0A;"
			/>
		</Configuration>
	</Configurations>
