		msl_Texture_lookup_2d_1_result.a = 1;
	}
	msl_Texture_lookup_2d_1_result.a *= __irrlicht_Diffuse_color.a;
	float4 msl_Illumination_phong_1_sum;
	float4 msl_Illumination_phong_1_diffuse;
	float4 msl_Illumination_phong_1_specular;
	Illumination_phong_main(state, __irrlicht_Diffuse_color, msl_Illumination_phong_1_diffuse_scalar, msl_Illumination_phong_1_specular_color, msl_Illumination_phong_1_specular_scalar, msl_Illumination_phong_1_specular_shininess, msl_Illumination_phong_1_sum, msl_Illumination_phong_1_diffuse, msl_Illumination_phong_1_specular);
	float4 msl_Math_color_multiply_1_result;
	Math_color_multiply_main(state, msl_Texture_lookup_2d_1_result, msl_Illumination_phong_1_diffuse, msl_Math_color_multiply_1_result);
//	msl_Math_color_multiply_1_result *= __irrlicht_Diffuse_multiplier;
	float4 msl_Component_reflection_1_result;
	Component_reflection_main(state, msl_Component_reflection_1_result);
	float4 msl_Math_color_multiply_2_result;
	Math_color_multiply_main(state, msl_Illumination_phong_1_diffuse, msl_Component_reflection_1_result, msl_Math_color_multiply_2_result);
	Math_color_add_main(state, msl_Math_color_multiply_1_result, msl_Math_color_multiply_2_result, msl_result);
	return msl_result;
}

//
// This function is the main method of the fragment shader. It initializes the
// values in the state structure that are used by nodes in the shader graph
// and produces the final result of the shader.
//
float4 fragment_main(
	Vert2frag_in fs_in) : COLOR
{
	State state;
	state.position = fs_in.position;
	state.normal = normalize(fs_in.normal);
	state.tex_coord = fs_in.tex_coord;
	state.origin = __camera_to_world[3];
	float3 eye_to_pos = state.position - state.origin;
	state.ray_length = length(eye_to_pos);
	state.direction = eye_to_pos/state.ray_length;
	return Math_color_add_1_eval(state);
}

//
// The following define the default technique and pass of the effect.
//
technique Backface_Culling
{
	pass P0
	{
		ZEnable      = true;
		ZWriteEnable = true;
		CullMode     = CW;
		VertexShader = compile vs_3_0 vertex_main();
		PixelShader  = compile ps_3_0 fragment_main();
	}
}
technique Frontface_Culling
{
	pass P0
	{
		ZEnable      = true;
		ZWriteEnable = true;
		CullMode     = CCW;
		VertexShader = compile vs_3_0 vertex_main();
		PixelShader  = compile ps_3_0 fragment_main();
	}
}
technique No_Culling
{
	pass P0
	{
		ZEnable      = true;
		ZWriteEnable = true;
		CullMode     = none;
		VertexShader = compile vs_3_0 vertex_main();
		PixelShader  = compile ps_3_0 fragment_main();
	}
}
technique Additive
{
	pass P0
	{
		ZEnable      = true;
		ZWriteEnable = false;
		AlphaBlendEnable = True;
		SrcBlend = SrcAlpha ;
		DestBlend = One;
		CullMode     = CW;
		VertexShader = compile vs_3_0 vertex_main();
		PixelShader  = compile ps_3_0 fragment_main();
	}
}
