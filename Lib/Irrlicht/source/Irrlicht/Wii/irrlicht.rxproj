			</setting>
			<setting entry="standardKeywords" uuid-alias="BuildFslCompilerCommon40">
				<simple>false</simple>
			</setting>
			<setting entry="optimizationLevel" uuid-alias="BuildFslCompilerCommon40">
				<simple>4</simple>
			</setting>
			<setting entry="optimizationSpaceOrSpeed" uuid-alias="BuildFslCompilerCommon40">
				<simple>2</simple>
			</setting>
			<setting entry="inlineDepth" uuid-alias="BuildFslCompilerCommon40">
				<simple>9</simple>
			</setting>
			<setting entry="inlineAuto" uuid-alias="BuildFslCompilerCommon40">
				<simple>true</simple>
			</setting>
			<setting entry="stringsPooling" uuid-alias="BuildFslCompilerCommon40">
				<simple>false</simple>
			</setting>
			<setting entry="finalOutputName" uuid-alias="Dictionary2">
