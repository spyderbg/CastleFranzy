			<!-- C++ specific settings -->
			<setting entry="forceC99Extensions" uuid-alias="BuildFslCompilerCommon40">
				<simple>false</simple>
			</setting>
			<setting entry="booleans" uuid-alias="BuildFslCompilerCommon40">
				<simple>true</simple>
			</setting>
			<setting entry="wchar_t" uuid-alias="BuildFslCompilerCommon40">
				<simple>true</simple>
			</setting>
			<!-- End of C++ specific settings -->
			<setting entry="systemIncludes" uuid-alias="Dictionary">
				<array>
					<simple>${project}\..\..\..\include</simple>
					<simple>${project}\..\zlib</simple>
					<simple>${project}\..\libpng</simple>
					<simple>${project}\..\jpeglib</simple>
					<simple>${project}\..\freetype\include</simple>
