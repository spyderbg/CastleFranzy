				</array>
			</setting>
			<setting entry="userCompileSwitches" uuid-alias="Dictionary">
				<simple>-D_WII -D_IRR_STATIC_LIB_ -DPNG_NO_CONST</simple>
			</setting>
			<setting entry="intermediateOutput" uuid-alias="Dictionary2">
				<simple>${project}/../obj/IrrWiiDebug/${TargetName}</simple>
			</setting>
			<setting entry="finalOutputDir" uuid-alias="Dictionary2">
