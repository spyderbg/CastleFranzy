        <instance_geometry url="#BLINK-mesh">
          <bind_material>
            <technique_common>
              <instance_material symbol="tex_host" target="#tex_host">
                <bind_vertex_input semantic="CHANNEL1" input_semantic="TEXCOORD" input_set="1"/>
              </instance_material>
            </technique_common>
          </bind_material>
        </instance_geometry>
      </node>
      <node id="mesh_host_body-node" name="mesh_host_body" type="NODE">
        <instance_controller url="#mesh_host_body-mesh-skin">
          <skeleton>#Bip01-node</skeleton>
          <skeleton>#Bip01_Spine-node</skeleton>
          <bind_material>
            <technique_common>
              <instance_material symbol="tex_host" target="#tex_host">
                <bind_vertex_input semantic="CHANNEL1" input_semantic="TEXCOORD" input_set="1"/>
              </instance_material>
            </technique_common>
          </bind_material>
        </instance_controller>
      </node>
      <node id="VisualSceneNode" type="NODE">
        <rotate>1 0 0 -90</rotate>
        <instance_light url="#ambient-environment-light"/>
      </node>
      <extra>
        <technique profile="FCOLLADA">
          <start_time>0</start_time>
          <end_time>2.5</end_time>
        </technique>
      </extra>
      <extra>
        <technique profile="MAX3D">
          <frame_rate>30</frame_rate>
        </technique>
      </extra>
    </visual_scene>
  </library_visual_scenes>
  <scene>
    <instance_visual_scene url="#host_happy.max"/>
  </scene>
</COLLADA>
