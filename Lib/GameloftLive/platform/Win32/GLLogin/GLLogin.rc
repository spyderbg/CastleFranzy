    "/",            IDM_ABOUT,              ASCII,  ALT
END


/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_ABOUTBOX DIALOGEX 22, 17, 230, 75
STYLE DS_SETFONT | DS_MODALFRAME | WS_CAPTION | WS_SYSMENU
CAPTION "About"
FONT 8, "System", 0, 0, 0x0
BEGIN
    ICON            IDI_IRF10,IDC_MYICON,14,9,16,16
    LTEXT           "GLLogin Win32 Version",IDC_STATIC,49,10,119,8,SS_NOPREFIX
    LTEXT           "Copy right (C) 2008",IDC_STATIC,49,20,119,8
    DEFPUSHBUTTON   "OK",IDOK,195,6,30,11,WS_GROUP
END

IDD_TOUCH_SETTING DIALOGEX 0, 0, 143, 174
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION
CAPTION "Setting"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Action:",IDC_STATIC,15,19,24,8
    COMBOBOX        IDC_COMBO_ACTION,48,17,77,100,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Param:",IDC_STATIC,15,60,24,8
