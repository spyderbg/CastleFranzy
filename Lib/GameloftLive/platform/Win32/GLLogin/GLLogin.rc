/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDC_IRF10 MENU 
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "E&xit",                       IDM_EXIT
    END
    POPUP "&Setting"
    BEGIN
        POPUP "&Display"
        BEGIN
            MENUITEM "Direct3D",                    ID_DISPLAY_DIRECT3D, CHECKED
            MENUITEM "GDI",                         ID_DISPLAY_GDI
            MENUITEM SEPARATOR
            MENUITEM "Angle 0",                     ID_DISPLAY_ANGLE_0, CHECKED
            MENUITEM "Angle 90",                    ID_DISPLAY_ANGLE_90
            MENUITEM "Angle 180",                   ID_DISPLAY_ANGLE_180, GRAYED
            MENUITEM "Angle 270",                   ID_DISPLAY_ANGLE_270
            MENUITEM SEPARATOR
            MENUITEM "1x",                          ID_ZOOM_1X, CHECKED
            MENUITEM "2x",                          ID_ZOOM_2X
        END
        POPUP "F&ps"
        BEGIN
            MENUITEM "15 fps",                      ID_FPS_15FPS
            MENUITEM "20 fps",                      ID_FPS_20FPS, CHECKED
            MENUITEM "30 fps",                      ID_FPS_30FPS 
        END
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About ...",                  IDM_ABOUT
    END
END

IDR_POPMENU MENU 
BEGIN
    POPUP "&PopMenu"
    BEGIN
        MENUITEM "&Add Rect",                   ID_POPMENU_ADD_RECT
        MENUITEM "&Remove Rect",                ID_POPMENU_REMOVERECT
        MENUITEM SEPARATOR
        MENUITEM "Pack 1",                      ID_POPMENU_PACK1, CHECKED
        MENUITEM "Pack 2",                      ID_POPMENU_PACK2
        MENUITEM "Pack 3",                      ID_POPMENU_PACK3
        MENUITEM SEPARATOR
        MENUITEM "H&ide",                       ID_POPMENU_HIDE
        MENUITEM "Sh&ow",                       ID_POPMENU_SHOW
        MENUITEM "&Save",                       ID_POPMENU_SAVE
        MENUITEM "&Cancel",                     ID_POP_CANCEL
    END
END

