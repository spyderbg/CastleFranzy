    <DebuggerFlavor>WindowsLocalDebugger</DebuggerFlavor>
  </PropertyGroup>
  <ItemGroup>
    <ClCompile Include="..\..\Src\**\*.cpp" Exclude="..\..\Src\PlatformSpecifics\IPhone\**;..\..\Src\PlatformSpecifics\Linux\**" />
