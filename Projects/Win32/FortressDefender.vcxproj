    <NMakeOutput>$(CastleBuild)\bin\$(Configuration)\FortressDefender.exe</NMakeOutput>
    <NMakePreprocessorDefinitions>WIN32;OS_WIN32;_IRR_STATIC_LIB_;UNICODE;_UNICODE;NOMINMAX</NMakePreprocessorDefinitions>
