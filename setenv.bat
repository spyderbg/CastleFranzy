@echo off
rem **************************************************************
rem 					set project path
rem **************************************************************

if not defined FORTRESS_DEFENDER_SETENV (
	set FORTRESS_DEFENDER_SETENV="SET"
) else goto END
	
set PROJECT_PATH=%~dp0
set PROJECT_PRJ_PATH=%PROJECT_PATH%Projects
set PROJECT_SRC_PATH=%PROJECT_PATH%src
set PROJECT_DATA_PATH=%PROJECT_PATH%data
set PROJECT_BUILD_PATH=%PROJECT_PATH%build\bin
set PROJECT_TOOLS_PATH=%PROJECT_PATH%tools
set PROJECT_LIB_PATH=%PROJECT_PATH%lib\Output
set PROJECT_IRRLICHT_PATH=%PROJECT_PATH%lib\Irrlicht\source\Irrlicht
set OUTPUT_PATH=%PROJECT_BUILD_PATH%
set HEADERS_OUT_PATH=%PROJECT_SRC_PATH%\autogenerated

echo PROJECT_PATH=%PROJECT_PATH%

rem **************************************************************
