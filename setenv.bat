rem **************************************************************
rem We need this to build the alpha pngs
rem set JAVA_PATH=C:\j2sdk1.4.2_04
set JAVA_PATH=c:\j2sdk1.4.2_04
set JAVA_EXE=%JAVA_PATH%\bin\java.exe
echo JAVA_EXE=%JAVA_EXE%
echo. 

:END

if not exist %JAVA_PATH% (
