{
  "name": "auroramx",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "build": "npm run typecheck && tsx scripts/build.ts",
    "build:cli": "esbuild backend/cli.ts --bundle --platform=node --target=node22 --format=cjs --outfile=build/cli.cjs",
    "start": "node build/server.cjs",
    "typecheck": "vue-tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "export:game": "tsx backend/cli.ts batch ../../Data/Sprites/Sprites.sprcmd",
    "package": "npm run build && tsx scripts/package.ts",
    "package:linux": "npm run build && tsx scripts/package.ts --target linux",
    "package:windows": "npm run build && tsx scripts/package.ts --target windows"
  },
  "dependencies": {
    "@lucide/vue": "^1.59.0",
    "fastify": "^5.6.0",
    "pngjs": "^7.0.0",
    "vue": "^3.5.22",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "@types/pngjs": "^6.0.5",
    "@vitejs/plugin-vue": "^6.0.1",
    "esbuild": "^0.25.0",
    "postject": "^1.0.0-alpha.6",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vue-tsc": "^3.0.8"
  }
}
