{
  "name": "castle-frenzy-level-editor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "typecheck": "vue-tsc --noEmit",
    "build": "npm run typecheck && tsx scripts/build.ts",
    "start": "node build/server.cjs",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "package": "npm run build && tsx scripts/package.ts",
    "package:linux": "npm run build && tsx scripts/package.ts --target linux",
    "package:windows": "npm run build && tsx scripts/package.ts --target windows"
  },
  "dependencies": {
    "fastify": "^5.6.0",
    "fast-xml-parser": "^5.3.0",
    "pngjs": "^7.0.0",
    "three": "^0.180.0",
    "vue": "^3.5.22"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "@types/pngjs": "^6.0.5",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "esbuild": "^0.25.0",
    "postject": "^1.0.0-alpha.6",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vue-tsc": "^3.0.8"
  }
}
