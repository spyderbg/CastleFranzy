{
    "version": 3,
    "cmakeMinimumRequired": { "major": 3, "minor": 20, "patch": 0 },
    "configurePresets": [
        {
            "name": "linux-debug",
            "displayName": "Ubuntu Debug (32-bit assets)",
            "generator": "Unix Makefiles",
            "binaryDir": "${sourceDir}/build/linux-debug",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
        },
        {
            "name": "linux-release",
            "displayName": "Ubuntu Release (32-bit assets)",
            "inherits": "linux-debug",
            "binaryDir": "${sourceDir}/build/linux-release",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
        }
    ],
    "buildPresets": [
        { "name": "linux-debug", "configurePreset": "linux-debug", "jobs": 8 },
        { "name": "linux-release", "configurePreset": "linux-release", "jobs": 8 }
    ]
}
