# Loaded before project() so compiler checks use the resource-compatible ABI.
set(CMAKE_C_FLAGS_INIT "-m32")
set(CMAKE_CXX_FLAGS_INIT "-m32")
set(CMAKE_LIBRARY_ARCHITECTURE i386-linux-gnu)

# Optional rootless Ubuntu dependencies, prepared by tools/linux/bootstrap.sh.
get_filename_component(CASTLE_DEPS "${CMAKE_CURRENT_LIST_DIR}/../.deps/root" ABSOLUTE)
if(EXISTS "${CASTLE_DEPS}/usr/lib32/crt1.o")
    file(GLOB CASTLE_GCC_DIRS "${CASTLE_DEPS}/usr/lib/gcc/x86_64-linux-gnu/*/32")
    list(SORT CASTLE_GCC_DIRS COMPARE NATURAL ORDER DESCENDING)
    list(GET CASTLE_GCC_DIRS 0 CASTLE_GCC_DIR)
    get_filename_component(CASTLE_GCC_VERSION_DIR "${CASTLE_GCC_DIR}" DIRECTORY)
    get_filename_component(CASTLE_GCC_VERSION "${CASTLE_GCC_VERSION_DIR}" NAME)
    set(CASTLE_LOCAL_FLAGS "-m32 -B${CASTLE_DEPS}/usr/lib32/ -B${CASTLE_GCC_DIR}/ -isystem ${CASTLE_DEPS}/usr/include -isystem ${CASTLE_DEPS}/usr/include/x86_64-linux-gnu")
    set(CMAKE_C_FLAGS_INIT "${CASTLE_LOCAL_FLAGS}")
    set(CMAKE_CXX_FLAGS_INIT "${CASTLE_LOCAL_FLAGS} -isystem ${CASTLE_DEPS}/usr/include/x86_64-linux-gnu/c++/${CASTLE_GCC_VERSION}/32")
    set(CMAKE_EXE_LINKER_FLAGS_INIT "-L${CASTLE_DEPS}/usr/lib32 -L${CASTLE_DEPS}/usr/lib/i386-linux-gnu -Wl,--disable-new-dtags,-rpath,${CASTLE_DEPS}/usr/lib/i386-linux-gnu:${CASTLE_DEPS}/usr/lib32 -Wl,--dynamic-linker=${CASTLE_DEPS}/usr/lib32/ld-linux.so.2")
    list(PREPEND CMAKE_PREFIX_PATH "${CASTLE_DEPS}/usr")
    list(PREPEND CMAKE_LIBRARY_PATH "${CASTLE_DEPS}/usr/lib/i386-linux-gnu")
    set(CMAKE_IGNORE_PATH /usr/lib/x86_64-linux-gnu /lib/x86_64-linux-gnu)
endif()
